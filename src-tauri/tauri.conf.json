{
  "$schema": "https://raw.githubusercontent.com/nicegui-org/nicegui/main/nicegui/json_schemas/tauri-conf-v2.json",
  "productName": "draw.io",
  "version": "31.1.5",
  "identifier": "com.jgraph.drawio",
  "build": {
    "beforeBuildCommand": "npm run sync",
    "beforeDevCommand": "",
    "frontendDist": "../drawio/src/main/webapp"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "drawio"
        ],
        "mimeType": "application/vnd.jgraph.mxfile",
        "name": "draw.io Diagram"
      },
      {
        "ext": [
          "drawio.xml"
        ],
        "mimeType": "application/xml",
        "name": "draw.io XML Diagram"
      },
      {
        "ext": [
          "vsdx"
        ],
        "mimeType": "application/vnd.visio",
        "name": "Visio Document"
      },
      {
        "ext": [
          "mmd",
          "mermaid"
        ],
        "mimeType": "text/vnd.mermaid",
        "name": "Mermaid Diagram"
      }
    ]
  },
  "plugins": {
    "dialog": null,
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/rede97/drawio-tauri/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyQzFFMzVDMTMyQTZERTgKUldUb2JTb1RYT1BCa2kybmRzVWU0ZmxVUW96K1N1K2R3dHc2Z1FvakJtQlJic1g2NFVJSXVTeGIK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}